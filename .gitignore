# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Node
node_modules/
# ...and as a symlink, which the pattern above does not match
node_modules
dist/
.vite/

# Data & runtime artifacts
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/uploads/
data/snapshot/
data/eval/
*.log

# Env
.env
.env.local

# OS / editor
.DS_Store
.idea/
.vscode/

# TypeScript incremental build info
*.tsbuildinfo
# local model weights (make deps-stt); never committed
data/models/
deploy/.env

# The browser OCR engine is copied from node_modules on install
# (frontend/scripts/ocr-assets.mjs); only the language model is kept in git.
frontend/public/ocr/*
!frontend/public/ocr/eng.traineddata.gz

# The Vercel CLI's local project link and the env file it pulls
.vercel
.env.local
