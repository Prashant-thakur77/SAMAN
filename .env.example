# SAMAN — environment. All values optional; defaults keep the app fully offline.

# SQLite database file (relative to repo root)
SAMAN_DB_PATH=./data/app.db

# Session cookie signing secret (dev default is fine for the prototype)
SAMAN_SECRET_KEY=saman-dev-secret-change-me

# Tier-3 LLM adjudication + Copilot prose. LEAVE UNSET for the offline demo.
# When unset, SAMAN uses the deterministic rule-based adjudicator and templated
# Copilot answers. When set, must point at a local Ollama instance.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:7b

# Sovereign mode: when true, OLLAMA_URL is ignored and the Copilot is forced local.
SAMAN_SOVEREIGN_MODE=false

# Frontend dev server -> backend origin
VITE_API_BASE=http://localhost:8000
