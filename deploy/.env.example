# Copy to deploy/.env and edit. Nothing in this file is optional for a real deployment.

# Signs the session cookie. The development default is refused for anything but localhost.
SAMAN_SECRET_KEY=change-me-to-a-long-random-string

# Cookies marked Secure are only sent over HTTPS. Keep true behind a domain or a
# tunnel; set false only when serving plain HTTP inside a LAN.
SAMAN_SECURE_COOKIES=true

# ":80" for plain HTTP on port 80. A hostname (saman.example.gov.in) turns on HTTPS.
SAMAN_DOMAIN=:80
SAMAN_HTTP_PORT=80
SAMAN_HTTPS_PORT=443

# The login page's account picker and the shared password "demo". True for a
# demo, false for a deployment with real accounts.
SAMAN_DEMO_LOGIN=true

# Tier 3. Leave empty for the rule-based adjudicator. With `--profile llm` the
# model runs beside the API: http://ollama:11434. On a laptop that already runs
# Ollama: http://host.docker.internal:11434
# Laptop with Ollama on the host (GPU): use --profile host-llm and http://host.docker.internal:11435
OLLAMA_URL=
OLLAMA_MODEL=qwen2.5:3b
# Reuse a model store that already exists on this machine (leave empty for a
# fresh volume). Linux service install: /usr/share/ollama/.ollama  user install: ~/.ollama
OLLAMA_MODELS_DIR=
OLLAMA_MODELS_RO=

# Optional engines baked into the API image: "voice" adds local speech
# recognition and synthesis and the OCR reader (+~600 MB). Their model files
# come from data/models, fetched once with make deps-stt / deps-tts.
SAMAN_EXTRAS=none
