# One origin for the app and its API inside a single container. The host
# terminates HTTPS and hands us plain HTTP on $PORT (7860 on Hugging Face).
{
	admin off
	auto_https off
}

:{$PORT:7860} {
	encode gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		root * /srv/www
		try_files {path} /index.html
		file_server
	}
}
