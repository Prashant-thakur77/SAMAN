# SAMAN web: the production frontend build, served by Caddy with /api proxied
# to the backend. Two stages so the final image carries no Node at all.
FROM node:22-slim AS build
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json* ./
# `npm ci` runs the postinstall that copies the browser OCR engine into
# public/ocr, so the script has to be here before the packages are.
COPY frontend/scripts ./scripts
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM caddy:2-alpine
COPY deploy/Caddyfile /etc/caddy/Caddyfile
COPY --from=build /src/dist /srv/www
